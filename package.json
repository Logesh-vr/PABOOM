{
  "name": "mein-instrument",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-worker.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/build-worker.mjs && node scripts/check-assets.mjs",
    "build": "tsc -b && vite build",
